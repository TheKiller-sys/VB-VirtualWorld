# ============================================================
# Cerebro World — configuración
# Copiar a .env y rellenar
# ============================================================

# ---------- Servidor ----------
BFF_PORT=5000
BFF_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
LOG_JSON=false

# ---------- Cerebro Digital ----------
CEREBRO_URL=http://srv2051648.hstgr.cloud/
CEREBRO_ADMIN_TOKEN=Josue2005
CEREBRO_TIMEOUT_MS=8000
POLL_INTERVAL_MS=10000
POLL_SESSIONS_LIMIT=200

# ---------- Autenticación del mundo ----------
# Token para crear/borrar entidades simuladas via API.
# OBLIGATORIO en producción (mínimo 16 caracteres).
WORLD_ADMIN_TOKEN=Josue2005

# Token para conectar al WebSocket.
# OBLIGATORIO en producción (mínimo 16 caracteres).
WORLD_WS_TOKEN=Josue2005

# ---------- Seguridad y cuotas ----------
# Máximo de entidades totales (reales + simuladas) vivas en el mundo.
MAX_TOTAL_ENTITIES=500

# Máximo de simuladas activas por IP.
MAX_SIMULATED_PER_IP=20

# Rate limit específico de POST /api/simulate (por IP).
SIMULATE_RATE_WINDOW_MS=60000
SIMULATE_RATE_MAX=5

# ---------- Simulación ----------
TICK_INTERVAL_MS=33
WORLD_WIDTH=2000
WORLD_HEIGHT=2000
WORLD_MARGIN=100

WANDER_STRENGTH=8
ATTRACT_STRENGTH=40
REPEL_STRENGTH=60
MAX_VELOCITY=30
FRICTION=0.92

ATTRACT_RADIUS=350
INTERACT_RADIUS=45
INTERACT_COOLDOWN_MS=8000
RELATION_DECAY_PER_HOUR=0.05

ENTITY_TIMEOUT_MS=1800000
ENTITY_FADE_MS=60000

# ---------- WebSocket ----------
WS_MAX_CLIENTS=100
WS_BROADCAST_HZ=15

# ---------- Persistencia ----------
WORLD_DB_PATH=./data/world.db
SNAPSHOT_INTERVAL_MS=60000
EVENT_RETENTION=5000

# ---------- Demo mode ----------
DEMO_MODE=false
DEMO_ENTITY_COUNT=12

# ---------- Rate limiting global ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ============================================================
# VARIABLES NUEVAS (V1.3.0)
# Estas son las que faltaban en tu .env original.
# Los valores por defecto son los que recomiendo empezar.
# ============================================================

# ---------- Cerebro Digital (nuevos nombres de polling) ----------
# Delay inicial antes del primer poll
CEREBRO_INITIAL_DELAY_MS=30000

# Intervalo mínimo entre polls
CEREBRO_MIN_INTERVAL_MS=30000

# Intervalo máximo (tope del backoff)
CEREBRO_MAX_INTERVAL_MS=300000

# Máximo de sesiones a pedir por poll
CEREBRO_MAX_SESSIONS_PER_POLL=50

# Máximo de perfiles completos por poll
CEREBRO_MAX_FULL_PROFILES=3

# ---------- Peer token (communityProtocol) ----------
# Token para /api/peer/inbox y /api/peer/outbox
# ⚠️ DEBE COINCIDIR con PEER_TOKEN en el .env del Cerebro Digital
CEREBRO_PEER_TOKEN=ddsfdhtrhrtggerhtrj455455y54655

# ---------- Identidad del mundo ----------
# ID del mundo como peer ante el Cerebro
WORLD_PEER_ID=world_bff

# ---------- Diálogo con LLM del Cerebro ----------
LLM_DIALOGUE_ENABLED=true
LLM_DIALOGUE_MIN_INTERVAL_MS=30000
LLM_DIALOGUE_TIMEOUT_MS=20000
LLM_DIALOGUE_CACHE_SIZE=200
LLM_DIALOGUE_CACHE_TTL_MS=7200000
LLM_DIALOGUE_SESSION_ID=world_sim_v1
LLM_DIALOGUE_MAX_LINES=3

# ---------- communityProtocol ----------
COMMUNITY_PROTOCOL_ENABLED=false
COMMUNITY_PROTOCOL_MIN_INTERVAL_MS=15000
COMMUNITY_PROTOCOL_MESSAGE_TYPE=shared_thought
COMMUNITY_PROTOCOL_FETCH_ENABLED=true
COMMUNITY_PROTOCOL_FETCH_INTERVAL_MS=15000
