# ============================================================
# Cerebro World — configuración
# Copiar a .env y rellenar
# ============================================================

# ---------- Servidor ----------
BFF_PORT=5000
BFF_HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
LOG_JSON=false

# ---------- Cerebro Digital ----------
CEREBRO_URL=srv2051648.hstgr.cloud
CEREBRO_ADMIN_TOKEN=Josue2005
CEREBRO_TIMEOUT_MS=8000
POLL_INTERVAL_MS=10000
POLL_SESSIONS_LIMIT=200

# ---------- Autenticación del mundo ----------
# Token para crear/borrar entidades simuladas via API.
# DEJA VACÍO SOLO EN DESARROLLO — en producción es obligatorio.
WORLD_ADMIN_TOKEN=Josue2005

# Token opcional para conectar al WS. Si está vacío, el WS es público.
WORLD_WS_TOKEN=Josue2005

# ---------- Simulación ----------
TICK_INTERVAL_MS=33
WORLD_WIDTH=2000
WORLD_HEIGHT=2000
WORLD_MARGIN=100

WANDER_STRENGTH=8
ATTRACT_STRENGTH=40
REPEL_STRENGTH=60
MAX_VELOCITY=30
FRICTION=0.92

ATTRACT_RADIUS=350
INTERACT_RADIUS=45
INTERACT_COOLDOWN_MS=8000
RELATION_DECAY_PER_HOUR=0.05

ENTITY_TIMEOUT_MS=1800000
ENTITY_FADE_MS=60000

# ---------- WebSocket ----------
WS_MAX_CLIENTS=100
WS_BROADCAST_HZ=15

# ---------- Persistencia ----------
WORLD_DB_PATH=./data/world.db
SNAPSHOT_INTERVAL_MS=60000
EVENT_RETENTION=5000

# ---------- Demo mode ----------
# Si true, genera entidades ficticias al arrancar. Útil sin Cerebro.
DEMO_MODE=false
DEMO_ENTITY_COUNT=12

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
